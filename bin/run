#!/usr/bin/env bash
set -o errexit -o pipefail

here="$(cd -- "$(dirname -- "${BASH_SOURCE[0]:-}")" &>/dev/null && pwd 2>/dev/null)"
# shellcheck source=bin/libDocker.bash
source "$here/libDocker.bash"
resolveDockerComposeCommand

distFolder="$here/../dist"
mkdir --parents "$distFolder"
"${dockerComposeCommand[@]}" --file "$here/../docker-compose.yml" up --build --no-start |& tee "$distFolder/build.log"
"${dockerComposeCommand[@]}" --file "$here/../docker-compose.yml" up --exit-code-from main --timeout 180 "$@" |& tee "$distFolder/run.log"